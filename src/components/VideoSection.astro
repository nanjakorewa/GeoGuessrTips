---
/**
 * VideoSection — the in-page, crawlable rendering of a page's `videoPanel`
 * frontmatter.
 *
 * VideoPanel.astro renders the same entries as a slide-up modal, which is good
 * UX but invisible to search engines twice over: the dialog carries `hidden`
 * (so it is `display: none` when rendered) and its iframes hold their URL in
 * `data-src`, so there is no video element on the page at all. Google reports
 * that as "no video found on the video watch page" and refuses to index any of
 * it, however accurate the VideoObject markup is.
 *
 * This section fixes both conditions with the cheapest possible trade: the
 * iframes carry a real `src` — so they exist in the DOM for a crawler — plus
 * `loading="lazy"`, so a browser still fetches nothing until the section nears
 * the viewport. Visitors who never scroll this far pay roughly what the modal
 * cost them before.
 *
 * Instagram entries use the permalink's own `/embed/` endpoint rather than the
 * blockquote + embed.js dance the modal uses: embed.js only runs after the
 * modal opens, and an iframe is what needs to be in the markup here anyway.
 *
 * That endpoint serves a whole card - avatar row, media, action bar, caption -
 * not a bare player, so unlike a YouTube iframe it has an intrinsic height that
 * no fixed aspect box fits; a 9/16 frame simply clips its bottom off. Instagram
 * embeds therefore get their own height, and the embed reports its real height
 * back through the `MEASURE` postMessage that Instagram's own embed.js listens
 * for (see the script below) - the same mechanism, without the 100KB script.
 *
 * Rendered inside the article flow (never inside a `{{% tabs %}}` block, whose
 * panes are display:none until clicked). The modal is left in place: it only
 * covers the page once opened, so nothing is duplicated on screen.
 */
import type { Language } from "@lib/i18n-utils";
import { t } from "@i18n/translations";

interface VideoItem {
  type: "youtube" | "instagram";
  id?: string;
  url?: string;
  title?: string;
  orientation?: "portrait" | "landscape";
}

interface Props {
  videos: { title?: string; items: VideoItem[] };
  lang: Language;
}

const { videos, lang } = Astro.props;

const heading = videos.title ?? t("video_panel_title", lang);

// Same guard as the modal: drop malformed entries rather than emit a broken embed.
const items = videos.items.filter(
  (v) => (v.type === "youtube" && v.id) || (v.type === "instagram" && v.url)
);

const cards = items.map((v) => ({
  ...v,
  src:
    v.type === "youtube"
      ? `https://www.youtube.com/embed/${v.id}`
      : `${v.url!.split("?")[0].replace(/\/+$/, "")}/embed/`,
}));
---

{cards.length > 0 && (
  <section class="video-section" aria-labelledby="video-section-title">
    <h2 class="section-title" id="video-section-title">
      <i class="fas fa-play-circle"></i> {heading}
    </h2>
    <ul class="video-section__list">
      {cards.map((v) => (
        <li class={`video-section__item video-section__item--${v.orientation ?? "portrait"} video-section__item--${v.type}`}>
          <div class="video-section__frame">
            <iframe
              src={v.src}
              title={v.title ?? (v.type === "youtube" ? "YouTube" : "Instagram")}
              loading="lazy"
              frameborder="0"
              scrolling={v.type === "instagram" ? "no" : undefined}
              data-ig-embed={v.type === "instagram" ? "" : undefined}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
          {v.title && <p class="video-section__caption">{v.title}</p>}
        </li>
      ))}
    </ul>
  </section>
)}

<script is:inline>
  /* Instagram's embed page posts its rendered height to the parent as a
     `MEASURE` message; this is the one thing embed.js does that matters here.
     The frame is matched by comparing `event.source` with each iframe's
     contentWindow — the embed does not tell us which of them it is. */
  (function () {
    var frames = document.querySelectorAll("iframe[data-ig-embed]");
    if (!frames.length) return;

    window.addEventListener("message", function (e) {
      if (typeof e.data !== "string") return;
      if (e.origin.indexOf("//www.instagram.com") === -1) return;

      var data;
      try {
        data = JSON.parse(e.data);
      } catch (err) {
        return;
      }
      if (!data || data.type !== "MEASURE" || !data.details) return;

      var height = parseInt(data.details.height, 10);
      if (!height) return;

      for (var i = 0; i < frames.length; i++) {
        if (frames[i].contentWindow === e.source) {
          frames[i].style.height = height + "px";
          return;
        }
      }
    });
  })();
</script>

<style>
  .video-section {
    margin: 2.5rem 0;
  }

  .video-section__list {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding-left: 0;
    margin: 0;
    list-style: none;
  }

  .video-section__list > li::before {
    /* The global `.content ul li::before` bullet would sit over the embeds. */
    display: none;
  }

  .video-section__item {
    padding-left: 0;
    margin-bottom: 0;
    flex: 0 1 auto;
  }

  /* Shorts / reels are portrait; ordinary uploads opt into 16:9 via
     `orientation: landscape` in the frontmatter. Google skips videos it
     considers too small, so these are sized generously rather than as
     thumbnails. */
  .video-section__item--portrait .video-section__frame {
    width: min(320px, 100%);
    aspect-ratio: 9 / 16;
  }

  .video-section__item--landscape .video-section__frame {
    width: min(560px, 100%);
    aspect-ratio: 16 / 9;
  }

  .video-section__frame {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background: #000;
  }

  .video-section__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Instagram: no aspect box (see the note at the top of this file). The card
     is laid out by the embed itself, so the frame just wraps it and the iframe
     carries the height — a generous fallback here, the measured value once the
     embed reports it. 326px is the minimum width Instagram's embed renders at,
     so the frame is never narrowed past it on purpose. */
  .video-section__item--instagram .video-section__frame {
    width: min(340px, 100%);
    aspect-ratio: auto;
    overflow: visible;
    background: transparent;
  }

  .video-section__item--instagram .video-section__frame iframe {
    position: static;
    display: block;
    width: 100%;
    /* Close to what a reel embed measures at this width (~548px), so the
       correction below is invisible; the exact value arrives by postMessage. */
    height: 560px;
    border-radius: 8px;
    background: #fff;
  }

  .video-section__item--instagram .video-section__caption {
    max-width: 340px;
  }

  .video-section__caption {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.4;
    max-width: 320px;
  }

  .video-section__item--landscape .video-section__caption {
    max-width: 560px;
  }
</style>
