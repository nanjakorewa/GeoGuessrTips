---
/**
 * VideoPanel — floating "watch videos" button plus a navy panel that slides
 * up from the bottom of the viewport with YouTube / Instagram embeds.
 *
 * Driven entirely by the page's `videos` frontmatter (see content/config.ts),
 * so any prefecture or country page can opt in by adding the block to its
 * markdown. Nothing is rendered on pages without the field.
 *
 * Embeds are deliberately NOT loaded on page load:
 * - YouTube iframes carry their URL in `data-src` and only get a real `src`
 *   the first time the panel is opened.
 * - Instagram's embed.js (~100KB, third-party) is injected on first open too,
 *   then `instgrm.Embeds.process()` for any later render — the flow Instagram
 *   documents for embeds added after page load.
 * This keeps the cost of the feature at zero for visitors who never open it.
 *
 * The Instagram blockquote reproduces Instagram's own embed code: same
 * attributes, same inline styling (incl. the 326px min / 540px max width) and
 * same placeholder markup, with the permalink and credit line intact. Nothing
 * here overrides those styles — the card is sized to fit the embed instead.
 */
import type { Language } from "@lib/i18n-utils";
import { t } from "@i18n/translations";

interface VideoItem {
  type: "youtube" | "instagram";
  id?: string;
  url?: string;
  title?: string;
  orientation?: "portrait" | "landscape";
  /** Instagram credit line: display name and handle (without "@") */
  author?: string;
  handle?: string;
}

interface Props {
  videos: { title?: string; items: VideoItem[] };
  lang: Language;
  /** Prefecture pages say "この県の…", everything else "この地域の…" */
  isPref?: boolean;
  /**
   * Which corner the trigger sits in. Quiz pages put it bottom-left so it
   * stays clear of the map controls; "left" also hides the trigger on narrow
   * viewports, where the quiz layout collapses and no left gutter remains.
   */
  placement?: "right" | "left";
}

const { videos, lang, isPref = false, placement = "right" } = Astro.props;

const openLabel = t(isPref ? "video_panel_open_pref" : "video_panel_open_area", lang);
const panelTitle = videos.title ?? t("video_panel_title", lang);
const closeLabel = t("video_panel_close", lang);
const instaLabel = t("video_panel_open_post", lang);
const instaViewLabel = t("video_panel_insta_view_post", lang);
const instaSharedBy = t("video_panel_insta_shared_by", lang);

// Drop malformed entries at build time rather than emitting a broken embed.
const items = videos.items.filter(
  (v) => (v.type === "youtube" && v.id) || (v.type === "instagram" && v.url)
);

/** Normalise an Instagram permalink to the form used in Instagram's embed code. */
function instaPermalink(url: string): string {
  const base = url.split("?")[0].replace(/\/+$/, "");
  return `${base}/?utm_source=ig_embed&utm_campaign=loading`;
}

/** Credit line under the placeholder, mirroring Instagram's embed code. */
function instaCredit(v: VideoItem): string {
  if (!v.author && !v.handle) return instaLabel;
  const who = v.author && v.handle ? `${v.author}(@${v.handle})` : v.author ?? `@${v.handle}`;
  return instaSharedBy.replace("{author}", who);
}

// Precompute the per-embed strings so the markup below stays a plain map().
const cards = items.map((v) => ({
  ...v,
  permalink: v.type === "instagram" ? instaPermalink(v.url!) : "",
  credit: v.type === "instagram" ? instaCredit(v) : "",
}));
---

{items.length > 0 && (
  <Fragment>
    <button
      class={`video-panel-fab video-panel-fab--${placement}`}
      type="button"
      id="video-panel-fab"
      aria-controls="video-panel"
      aria-expanded="false"
    >
      <span class="video-panel-fab__icon" aria-hidden="true">
        <i class="fas fa-play"></i>
      </span>
      <span class="video-panel-fab__label">{openLabel}</span>
    </button>

    <div class="video-panel-backdrop" id="video-panel-backdrop" hidden></div>

    <section
      class="video-panel"
      id="video-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="video-panel-title"
      hidden
    >
      <div class="video-panel__head">
        <h2 class="video-panel__title" id="video-panel-title">{panelTitle}</h2>
        <button
          class="video-panel__close"
          type="button"
          id="video-panel-close"
          aria-label={closeLabel}
          title={closeLabel}
        >×</button>
      </div>

      <div class="video-panel__body">
        <ul class="video-panel__list">
          {cards.map((v) => (
            <li class={`video-card video-card--${v.type} video-card--${v.orientation ?? "portrait"}`}>
              <div class="video-card__frame">
                {v.type === "youtube" ? (
                  <iframe
                    class="video-card__iframe"
                    data-src={`https://www.youtube.com/embed/${v.id}`}
                    title={v.title ?? "YouTube"}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                    loading="lazy"
                  ></iframe>
                ) : (
                  <blockquote
                    class="instagram-media"
                    data-instgrm-captioned
                    data-instgrm-permalink={v.permalink}
                    data-instgrm-version="14"
                    style="background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin: 1px; max-width:540px; min-width:326px; padding:0; width:99.375%; width:-webkit-calc(100% - 2px); width:calc(100% - 2px);"
                  >
                    <div style="padding:16px;">
                      <a
                        href={v.permalink}
                        style="background:#FFFFFF; line-height:0; padding:0 0; text-align:center; text-decoration:none; width:100%;"
                        target="_blank"
                      >
                        <div style="display: flex; flex-direction: row; align-items: center;">
                          <div style="background-color: #F4F4F4; border-radius: 50%; flex-grow: 0; height: 40px; margin-right: 14px; width: 40px;"></div>
                          <div style="display: flex; flex-direction: column; flex-grow: 1; justify-content: center;">
                            <div style="background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; margin-bottom: 6px; width: 100px;"></div>
                            <div style="background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; width: 60px;"></div>
                          </div>
                        </div>
                        <div style="padding:19% 0;"></div>
                        <div style="display:block; height:50px; margin:0 auto 12px; width:50px;">
                          <svg width="50px" height="50px" viewBox="0 0 60 60" version="1.1" xmlns="https://www.w3.org/2000/svg">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                              <g transform="translate(-511.000000, -20.000000)" fill="#000000">
                                <g>
                                  <path d="M556.869,30.41 C554.814,30.41 553.148,32.076 553.148,34.131 C553.148,36.186 554.814,37.852 556.869,37.852 C558.924,37.852 560.59,36.186 560.59,34.131 C560.59,32.076 558.924,30.41 556.869,30.41 M541,60.657 C535.114,60.657 530.342,55.887 530.342,50 C530.342,44.114 535.114,39.342 541,39.342 C546.887,39.342 551.658,44.114 551.658,50 C551.658,55.887 546.887,60.657 541,60.657 M541,33.886 C532.1,33.886 524.886,41.1 524.886,50 C524.886,58.899 532.1,66.113 541,66.113 C549.9,66.113 557.115,58.899 557.115,50 C557.115,41.1 549.9,33.886 541,33.886 M565.378,62.101 C565.244,65.022 564.756,66.606 564.346,67.663 C563.803,69.06 563.154,70.057 562.106,71.106 C561.058,72.155 560.06,72.803 558.662,73.347 C557.607,73.757 556.021,74.244 553.102,74.378 C549.944,74.521 548.997,74.552 541,74.552 C533.003,74.552 532.056,74.521 528.898,74.378 C525.979,74.244 524.393,73.757 523.338,73.347 C521.94,72.803 520.942,72.155 519.894,71.106 C518.846,70.057 518.197,69.06 517.654,67.663 C517.244,66.606 516.755,65.022 516.623,62.101 C516.479,58.943 516.448,57.996 516.448,50 C516.448,42.003 516.479,41.056 516.623,37.899 C516.755,34.978 517.244,33.391 517.654,32.338 C518.197,30.938 518.846,29.942 519.894,28.894 C520.942,27.846 521.94,27.196 523.338,26.654 C524.393,26.244 525.979,25.756 528.898,25.623 C532.057,25.479 533.004,25.448 541,25.448 C548.997,25.448 549.943,25.479 553.102,25.623 C556.021,25.756 557.607,26.244 558.662,26.654 C560.06,27.196 561.058,27.846 562.106,28.894 C563.154,29.942 563.803,30.938 564.346,32.338 C564.756,33.391 565.244,34.978 565.378,37.899 C565.522,41.056 565.552,42.003 565.552,50 C565.552,57.996 565.522,58.943 565.378,62.101 M570.82,37.631 C570.674,34.438 570.167,32.258 569.425,30.349 C568.659,28.377 567.633,26.702 565.965,25.035 C564.297,23.368 562.623,22.342 560.652,21.575 C558.743,20.834 556.562,20.326 553.369,20.18 C550.169,20.033 549.148,20 541,20 C532.853,20 531.831,20.033 528.631,20.18 C525.438,20.326 523.257,20.834 521.349,21.575 C519.376,22.342 517.703,23.368 516.035,25.035 C514.368,26.702 513.342,28.377 512.574,30.349 C511.834,32.258 511.326,34.438 511.181,37.631 C511.035,40.831 511,41.851 511,50 C511,58.147 511.035,59.17 511.181,62.369 C511.326,65.562 511.834,67.743 512.574,69.651 C513.342,71.625 514.368,73.296 516.035,74.965 C517.703,76.634 519.376,77.658 521.349,78.425 C523.257,79.167 525.438,79.673 528.631,79.82 C531.831,79.965 532.853,80.001 541,80.001 C549.148,80.001 550.169,79.965 553.369,79.82 C556.562,79.673 558.743,79.167 560.652,78.425 C562.623,77.658 564.297,76.634 565.965,74.965 C567.633,73.296 568.659,71.625 569.425,69.651 C570.167,67.743 570.674,65.562 570.82,62.369 C570.966,59.17 571,58.147 571,50 C571,41.851 570.966,40.831 570.82,37.631"></path>
                                </g>
                              </g>
                            </g>
                          </svg>
                        </div>
                        <div style="padding-top: 8px;">
                          <div style="color:#3897f0; font-family:Arial,sans-serif; font-size:14px; font-style:normal; font-weight:550; line-height:18px;">{instaViewLabel}</div>
                        </div>
                        <div style="padding: 12.5% 0;"></div>
                        <div style="display: flex; flex-direction: row; margin-bottom: 14px; align-items: center;">
                          <div>
                            <div style="background-color: #F4F4F4; border-radius: 50%; height: 12.5px; width: 12.5px; transform: translateX(0px) translateY(7px);"></div>
                            <div style="background-color: #F4F4F4; height: 12.5px; transform: rotate(-45deg) translateX(3px) translateY(1px); width: 12.5px; flex-grow: 0; margin-right: 14px; margin-left: 2px;"></div>
                            <div style="background-color: #F4F4F4; border-radius: 50%; height: 12.5px; width: 12.5px; transform: translateX(9px) translateY(-18px);"></div>
                          </div>
                          <div style="margin-left: 8px;">
                            <div style="background-color: #F4F4F4; border-radius: 50%; flex-grow: 0; height: 20px; width: 20px;"></div>
                            <div style="width: 0; height: 0; border-top: 2px solid transparent; border-left: 6px solid #f4f4f4; border-bottom: 2px solid transparent; transform: translateX(16px) translateY(-4px) rotate(30deg)"></div>
                          </div>
                          <div style="margin-left: auto;">
                            <div style="width: 0px; border-top: 8px solid #F4F4F4; border-right: 8px solid transparent; transform: translateY(16px);"></div>
                            <div style="background-color: #F4F4F4; flex-grow: 0; height: 12px; width: 16px; transform: translateY(-4px);"></div>
                            <div style="width: 0; height: 0; border-top: 8px solid #F4F4F4; border-left: 8px solid transparent; transform: translateY(-4px) translateX(8px);"></div>
                          </div>
                        </div>
                        <div style="display: flex; flex-direction: column; flex-grow: 1; justify-content: center; margin-bottom: 24px;">
                          <div style="background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; margin-bottom: 6px; width: 224px;"></div>
                          <div style="background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; width: 144px;"></div>
                        </div>
                      </a>
                      <p style="color:#c9c8cd; font-family:Arial,sans-serif; font-size:14px; line-height:17px; margin-bottom:0; margin-top:8px; overflow:hidden; padding:8px 0 7px; text-align:center; text-overflow:ellipsis; white-space:nowrap;">
                        <a
                          href={v.permalink}
                          style="color:#c9c8cd; font-family:Arial,sans-serif; font-size:14px; font-style:normal; font-weight:normal; line-height:17px; text-decoration:none;"
                          target="_blank"
                        >{v.credit}</a>
                      </p>
                    </div>
                  </blockquote>
                )}
              </div>
              {v.title && <p class="video-card__caption">{v.title}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <script is:inline>
      (function () {
        var fab = document.getElementById("video-panel-fab");
        var panel = document.getElementById("video-panel");
        var backdrop = document.getElementById("video-panel-backdrop");
        var closeBtn = document.getElementById("video-panel-close");
        if (!fab || !panel || !backdrop) return;

        var hydrated = false;

        /* First open: give the YouTube iframes their real src and pull in
           Instagram's embed script. Both are one-shot. */
        function hydrate() {
          if (hydrated) return;
          hydrated = true;

          var frames = panel.querySelectorAll("iframe[data-src]");
          for (var i = 0; i < frames.length; i++) {
            frames[i].src = frames[i].getAttribute("data-src");
            frames[i].removeAttribute("data-src");
          }

          if (!panel.querySelector(".instagram-media")) return;
          if (window.instgrm && window.instgrm.Embeds) {
            window.instgrm.Embeds.process();
          } else if (!document.getElementById("instagram-embed-js")) {
            var s = document.createElement("script");
            s.id = "instagram-embed-js";
            s.async = true;
            s.src = "https://www.instagram.com/embed.js";
            document.body.appendChild(s);
          }
        }

        function open() {
          hydrate();
          backdrop.hidden = false;
          panel.hidden = false;
          /* Let the browser paint the hidden->shown swap before animating in,
             otherwise the transform transition is skipped. */
          requestAnimationFrame(function () {
            backdrop.classList.add("is-open");
            panel.classList.add("is-open");
          });
          fab.setAttribute("aria-expanded", "true");
          fab.classList.add("is-hidden");
          document.body.classList.add("has-video-panel-open");
          if (closeBtn) closeBtn.focus();
        }

        function close() {
          backdrop.classList.remove("is-open");
          panel.classList.remove("is-open");
          fab.setAttribute("aria-expanded", "false");
          fab.classList.remove("is-hidden");
          document.body.classList.remove("has-video-panel-open");
          /* Stop any playing video by reloading the iframe's own src. */
          var frames = panel.querySelectorAll("iframe[src]");
          for (var i = 0; i < frames.length; i++) {
            frames[i].src = frames[i].src;
          }
          window.setTimeout(function () {
            if (!panel.classList.contains("is-open")) {
              panel.hidden = true;
              backdrop.hidden = true;
            }
          }, 320);
          fab.focus();
        }

        fab.addEventListener("click", open);
        backdrop.addEventListener("click", close);
        if (closeBtn) closeBtn.addEventListener("click", close);
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && !panel.hidden) close();
        });
      })();
    </script>

    <style is:global>
      /* --- Floating trigger ------------------------------------------- */
      /* Square-cornered to match the site's hero/symbol-strip design. */
      .video-panel-fab {
        position: fixed;
        bottom: 24px;
        z-index: 1250;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1.1rem 1.85rem;
        background: #1a2535;
        color: #fff;
        border: 2px solid #fff;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.32);
        font-size: 1.08rem;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
        transition: transform 0.2s ease, background-color 0.2s ease, opacity 0.2s ease;
      }

      .video-panel-fab--right {
        right: 24px;
      }

      .video-panel-fab--left {
        left: 24px;
      }

      /* The quiz layout drops its 200px left rail below 980px, leaving no room
         beside the map. Rather than float the trigger over the quiz itself,
         hide it — the videos stay reachable from the prefecture guide page. */
      @media (max-width: 1099px) {
        .video-panel-fab--left {
          display: none;
        }
      }

      .video-panel-fab:hover,
      .video-panel-fab:focus {
        background: #0f1722;
        transform: translateY(-2px);
      }

      .video-panel-fab.is-hidden {
        opacity: 0;
        pointer-events: none;
      }

      .video-panel-fab__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.9rem;
        height: 1.9rem;
        background: #fff;
        color: #1a2535;
        flex: 0 0 auto;
      }

      .video-panel-fab__icon i {
        font-size: 0.85rem;
        /* Nudge the play triangle so it reads as optically centred */
        margin-left: 2px;
      }

      /* Keep the trigger clear of the fixed notice bar when both are present */
      body.has-notice-bar .video-panel-fab {
        bottom: 5.5rem;
      }

      /* --- Backdrop ---------------------------------------------------- */
      .video-panel-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1290;
        background: rgba(10, 15, 23, 0.6);
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .video-panel-backdrop.is-open {
        opacity: 1;
      }

      .video-panel-backdrop[hidden],
      .video-panel[hidden] {
        display: none;
      }

      /* --- Sliding panel ----------------------------------------------- */
      .video-panel {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1300;
        max-height: 88vh;
        display: flex;
        flex-direction: column;
        background: #1a2535;
        color: #fff;
        border-top: 3px solid #fff;
        box-shadow: 0 -6px 28px rgba(0, 0, 0, 0.4);
        transform: translateY(100%);
        transition: transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
      }

      .video-panel.is-open {
        transform: translateY(0);
      }

      .video-panel__head {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 1rem;
        max-width: 1400px;
        width: 100%;
        margin: 0 auto;
        padding: 0.9rem 1.5rem;
      }

      .video-panel__title {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
        color: #fff;
        flex: 1 1 auto;
      }

      .video-panel__close {
        flex: 0 0 auto;
        width: 2.25rem;
        height: 2.25rem;
        padding: 0;
        background: transparent;
        border: none;
        color: #fff;
        font-size: 1.6rem;
        line-height: 1;
        cursor: pointer;
      }

      .video-panel__close:hover,
      .video-panel__close:focus {
        background: rgba(255, 255, 255, 0.15);
      }

      .video-panel__body {
        flex: 1 1 auto;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
      }

      .video-panel__list {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 1.5rem 1.5rem;
        list-style: none;
        overflow-x: auto;
      }

      /* The global `.content ul li::before` bullet would show through here */
      .video-panel__list li::before {
        display: none;
      }

      .video-card {
        flex: 0 0 auto;
        width: 320px;
        margin: 0;
        padding: 0;
      }

      .video-card--landscape {
        width: 480px;
      }

      /* 326px = the min-width Instagram's embed code sets on its blockquote
         (and on the iframe embed.js swaps in). Narrower cards make it overflow. */
      .video-card--instagram {
        width: 326px;
      }

      .video-card__frame {
        position: relative;
        width: 100%;
        background: #0f1722;
      }

      /* Shorts / Reels are 9:16; ordinary uploads 16:9 */
      .video-card--portrait .video-card__frame {
        aspect-ratio: 9 / 16;
      }

      .video-card--landscape .video-card__frame {
        aspect-ratio: 16 / 9;
      }

      .video-card__iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }

      /* Instagram's embed.js swaps the blockquote for an iframe of its own and
         sets an explicit height, so this card cannot use a fixed aspect box. */
      .video-card--instagram .video-card__frame {
        aspect-ratio: auto;
        background: transparent;
      }

      /* Instagram's blockquote / rendered iframe carry their own inline
         styling. Nothing is overridden here — the card is simply wide enough
         for the 326px minimum width that embed code declares. */

      .video-card__caption {
        margin: 0.6rem 0 0;
        font-size: 0.82rem;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.82);
      }

      @media (max-width: 768px) {
        .video-panel-fab {
          bottom: 12px;
          padding: 0.9rem 1.3rem;
          font-size: 0.95rem;
        }

        .video-panel-fab--right {
          right: 12px;
        }

        .video-panel-fab--left {
          left: 12px;
        }

        .video-panel-fab__icon {
          width: 1.7rem;
          height: 1.7rem;
        }

        .video-panel {
          max-height: 82vh;
        }

        .video-panel__head {
          padding: 0.75rem 1rem;
        }

        .video-panel__title {
          font-size: 0.95rem;
        }

        .video-panel__list {
          padding: 0 1rem 1rem;
          gap: 1rem;
        }

        .video-card {
          width: 78vw;
          max-width: 320px;
        }

        .video-card--landscape {
          width: 88vw;
          max-width: 480px;
        }

        .video-card--instagram {
          width: 326px;
          max-width: none;
        }
      }
    </style>
  </Fragment>
)}
