<script is:inline>
(function () {
  "use strict";
  var stage = document.getElementById("stage");
  var tVideo = document.getElementById("transitionVideo");
  var scenes = stage.querySelectorAll(".scene");
  var state = { scene: "start", transition: "wipe", orientation: "h", playing: false };

  function srcFor(t, o) {
    return "/materials/assets/demo/" + (o === "v" ? "vertical_" : "transition_") + t + ".webm";
  }

  function setActive(groupSel, btn) {
    document.querySelectorAll(groupSel).forEach(function (b) { b.classList.remove("on"); });
    btn.classList.add("on");
  }

  function showScene(name) {
    scenes.forEach(function (s) { s.classList.toggle("active", s.dataset.name === name); });
    state.scene = name;
  }

  function playTransition(then) {
    if (state.playing) return;
    state.playing = true;
    tVideo.src = srcFor(state.transition, state.orientation);
    tVideo.style.display = "block";
    var swapped = false;
    var onTime = function () {
      if (!swapped && tVideo.currentTime >= 0.7) { swapped = true; then(); }
    };
    tVideo.addEventListener("timeupdate", onTime);
    tVideo.onended = function () {
      tVideo.removeEventListener("timeupdate", onTime);
      if (!swapped) then();
      tVideo.style.display = "none";
      state.playing = false;
    };
    tVideo.play().catch(function () {
      // Fallback: switch instantly if autoplay is blocked
      tVideo.removeEventListener("timeupdate", onTime);
      tVideo.style.display = "none";
      state.playing = false;
      then();
    });
  }

  document.querySelectorAll("[data-scene]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      if (state.playing || btn.dataset.scene === state.scene) return;
      setActive("[data-scene]", btn);
      playTransition(function () { showScene(btn.dataset.scene); });
    });
  });
  document.querySelectorAll("[data-t]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      state.transition = btn.dataset.t;
      setActive("[data-t]", btn);
    });
  });
  document.querySelectorAll("[data-o]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      state.orientation = btn.dataset.o;
      setActive("[data-o]", btn);
      stage.classList.toggle("vertical", state.orientation === "v");
    });
  });

  // Fake chat feed
  var chatList = document.getElementById("chatList");
  var fakeComments = [
    ["mika", "hello there!"], ["woodpecker", "this layout is so cute"], ["yama", "first time here"],
    ["puni", "that corner is tricky"], ["hato", "gg"], ["beans", "love this BGM"],
    ["rainboots", "nice one!"], ["shio", "what course is next?"], ["walnut", "lol"]
  ];
  var ci = 0;
  setInterval(function () {
    if (!chatList) return;
    var c = fakeComments[ci++ % fakeComments.length];
    var div = document.createElement("div");
    div.className = "chat-item";
    var b = document.createElement("b");
    b.textContent = c[0] + " ";
    div.appendChild(b);
    div.appendChild(document.createTextNode(c[1]));
    chatList.appendChild(div);
    while (chatList.children.length > 8) chatList.removeChild(chatList.firstChild);
  }, 2200);

  // Transition gallery
  document.querySelectorAll(".checker").forEach(function (box) {
    var v = box.querySelector("video");
    var play = function () {
      if (!v.src) v.src = box.dataset.src;
      v.currentTime = 0;
      v.play();
    };
    box.addEventListener("mouseenter", play); // オンマウスで再生
    box.addEventListener("click", play);      // タッチ端末用
  });

  // Disable right-click on sample areas (gallery + simulator stage)
  [document.getElementById("tGrid"), stage].forEach(function (el) {
    if (el) el.addEventListener("contextmenu", function (e) { e.preventDefault(); });
  });
})();
</script>
