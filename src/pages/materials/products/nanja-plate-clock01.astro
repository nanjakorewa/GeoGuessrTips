<link rel="stylesheet" href="/materials/assets/site.css">
<style is:global>
  /* この商品ページ専用: 時計デモの並べ方 */
  .clock-stage { background:#5a5f52; background-image:
      linear-gradient(45deg, rgba(255,255,255,.05) 25%, transparent 25%, transparent 75%, rgba(255,255,255,.05) 75%),
      linear-gradient(45deg, rgba(255,255,255,.05) 25%, transparent 25%, transparent 75%, rgba(255,255,255,.05) 75%);
      background-size:48px 48px; background-position:0 0, 24px 24px;
      border:2px solid var(--ink); box-shadow:5px 6px 0 rgba(74,63,51,.15);
      padding:26px; margin-top:30px; }
  .clock-stage p.cap { color:#fff; font-size:.9rem; margin-bottom:14px; opacity:.9; }
  .clock-row { display:flex; flex-wrap:wrap; gap:22px; justify-content:center; }
  .clock-item { width:406px; text-align:center; }
  .clock-item .fr { width:406px; height:86px; overflow:hidden; }
  .clock-row iframe { border:0; width:780px; height:165px; display:block;
    transform:scale(.52); transform-origin:0 0; }
  .clock-item span { display:block; color:#fff; font-size:.85rem; margin-top:12px; opacity:.92; }
  .clock-item code { font-family:Consolas,Monaco,monospace; font-size:.8rem;
    background:rgba(255,255,255,.14); padding:2px 8px; }
  .opts { width:100%; border-collapse:collapse; margin-top:26px; background:#fffdf6;
    border:2px solid var(--ink); box-shadow:4px 5px 0 rgba(74,63,51,.14); }
  .opts th, .opts td { border-bottom:1px solid rgba(74,63,51,.2); padding:11px 16px;
    text-align:left; font-size:.95rem; vertical-align:top; }
  .opts th { background:var(--paper-dark); letter-spacing:.1em; }
  .opts code { font-family:Consolas,Monaco,monospace; background:var(--paper-dark);
    padding:1px 7px; border:1px solid rgba(74,63,51,.25); font-size:.88rem; }
</style>
</head>
<body>

<header>
  <div class="wrap">
    <div class="brand"><a href="/materials/">nanja<span>素材</span></a></div>
    <nav>
      <a href="https://geopinning.space/" class="back">← GeoGuessrの攻略めも</a>
            <a href="/materials/#catalog">素材一覧</a>
