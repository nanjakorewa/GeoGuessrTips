<script is:inline>
(function () {
  "use strict";
  // 1920x1080 のデモを枠の幅に合わせて縮める
  function fit() {
    [["frame", "demo"], ["frame2", "demo2"]].forEach(function (pair) {
      var f = document.getElementById(pair[0]), d = document.getElementById(pair[1]);
      if (f && d) d.style.transform = "scale(" + (f.clientWidth / 1920) + ")";
    });
  }
  fit();
  window.addEventListener("resize", fit);
})();
</script>
